# Copy to .env and fill in. Never commit .env.

# Required. Bot token from https://discord.com/developers/applications -> Bot -> Reset Token.
DISCORD_TOKEN=paste-your-bot-token-here

# Invite the bot with scopes `bot` + `applications.commands` and permissions 34816,
# which is Send Messages (2048) + Attach Files (32768) — nothing else is needed.
# https://discord.com/api/oauth2/authorize?client_id=YOUR_APP_ID&permissions=34816&scope=bot%20applications.commands

# The botc-scripts instance to query. Defaults to the public site.
# Point this at your own deployment to use a self-hosted instance, e.g.
# BOTC_BASE_URL=https://scripts.example.com
BOTC_BASE_URL=https://www.botcscripts.com

# Optional. A guild (server) id makes slash commands register instantly there,
# instead of waiting up to an hour for a global sync. Use this while developing.
# DISCORD_GUILD_ID=123456789012345678

# Optional, and SELF-HOST ONLY. Custom ids let a script be addressed as `sects` rather
# than `13108`; /script and /json accept either, and /alias sets and clears them. They
# are a feature of a self-hosted botc-scripts FORK — the public site has no such field,
# so against it /alias explains that and changes nothing, credentials or not.
#
# These must name a Django user on your instance holding the
# `scripts.api_write_permission` permission. The bot sends them as HTTP Basic, and only
# ever to set or clear a custom id; every other request it makes is anonymous. Reading
# custom ids needs no credentials at all — only /alias set and /alias clear do.
#
# Set BOTH or NEITHER: half a credential is a startup error rather than a bot that
# silently cannot write. Over a plain http:// base URL they cross the network
# unencrypted, which is fine inside a private network (a Docker Compose bridge, say)
# and logged as a warning so it is not a surprise anywhere else.
# BOTC_API_USER=discordbot
# BOTC_API_PASSWORD=change-me

# Optional tuning.
# BOTC_RENDER_DPI=150          # 50-400. Higher is sharper and much larger.
# BOTC_MAX_PAGES=10            # 1-10. Pages rendered per script; the rest are linked.
# BOTC_HTTP_TIMEOUT=60         # Seconds, total, per upstream request.
# BOTC_MAX_PDF_BYTES=62914560  # Refuse to download PDFs larger than this.
# LOG_LEVEL=INFO               # CRITICAL, ERROR, WARNING, INFO or DEBUG.

# Serve only scripts marked as on the Minecraft server. /script and /json refuse the
# rest, and autocomplete stops suggesting them. Instances without the status field —
# the public site — send no status, which counts as available, so this never empties
# the catalogue there. Set false to serve everything.
# BOTC_ONLINE_ONLY=true

# Optional. Autocomplete suggests scripts this bot has already served, from a local
# SQLite file holding only a script id, name, author, guild id and timestamp — never the
# script JSON, and nothing identifying who ran the command. It is created on first use
# and is safe to delete at any time; the bot refills it as it serves more scripts.
# BOTC_CACHE_PATH=botc-suggestions.sqlite3  # Relative paths resolve to the working dir.
# BOTC_CACHE_ENTRIES=500                    # 0-100000. 0 disables the cache entirely.

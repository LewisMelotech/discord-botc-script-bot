# Copy to .env and fill in.  cp .env.example .env
#
# .env is gitignored. Never commit it — it holds the database password, the Django
# secret key and the Discord bot token.
#
# Anything commented out here is optional and falls back to the default shown.


# ---------------------------------------------------------------------------
# Required. The stack refuses to start without these two — there is deliberately
# no default password and no default secret key anywhere in this repo.
# ---------------------------------------------------------------------------

# Django's signing key. Generate a fresh one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# Changing it later invalidates every session and password-reset link.
SECRET_KEY=

# Postgres password. Any long random string; nothing outside this stack uses it.
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=


# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# POSTGRES_USER=botc
# POSTGRES_DB=botc

# Seconds a database connection is reused for. 0 disables persistent connections.
# DB_CONN_MAX_AGE=60


# ---------------------------------------------------------------------------
# The Django app
# ---------------------------------------------------------------------------

# Space-separated ALLOWED_HOSTS. Keep "botc-scripts" in the list — that is the Host
# header the bot sends over the internal Docker network, and Django replies 400 to any
# host it does not recognise. Add your own hostname if you put this behind a proxy:
#   DJANGO_HOST=localhost 127.0.0.1 botc-scripts scripts.example.com
# DJANGO_HOST=localhost 127.0.0.1 botc-scripts

# Origins allowed to submit forms (login, upload). Must include the scheme. Add your
# public origin here too if you serve the site from one.
# CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Where the web UI is published on the host. The bot does not use this — it talks to
# http://botc-scripts:8000 inside the Docker network. Loopback-only by default; set
# APP_BIND=0.0.0.0 to reach it from other machines on your LAN.
# APP_BIND=127.0.0.1
# APP_PORT=8000

# Set to True only when a TLS-terminating reverse proxy sits in front of the app. It
# turns on secure cookies and trusts X-Forwarded-Proto.
# BEHIND_TLS_PROXY=False

# Never set DEBUG=True on anything reachable from outside your machine.
# DEBUG=False

# Turn off uploading and importing for everyone but staff, on the site and through the
# API alike, and show a site-wide banner message. The daily sync is not affected.
# UPLOAD_DISABLED=False
# BANNER=

# Who may register. Two independent switches, one for each way in: a username and
# password, and a social provider (Discord, Google). Both close registration only —
# anyone who already has an account keeps logging in. Write exactly True or False:
# anything else, `true` included, counts as False. See ACCOUNTS.md in the fork.
# LOCAL_SIGNUP_ENABLED=True
# SOCIAL_SIGNUP_ENABLED=True

# When the sync service pulls new versions of linked scripts from wherever they were
# imported from: once a day at this time of day, in SYNC_TIMEZONE. The clock change is
# handled, so 09:00 stays 09:00 in London all year. Keep it daily: botcscripts.com blocks
# instances that ask it too often. Sync only ever ADDS versions, and new ones arrive
# offline, so nothing reaches Discord until someone marks it online.
# SYNC_AT=09:00
# SYNC_TIMEZONE=Europe/London

# Set SYNC_AT empty (SYNC_AT=) to sync every SYNC_PERIOD seconds instead, aligned to the
# period boundary rather than counted from container start. 86400 is midnight UTC.
# SYNC_PERIOD=3600

# Also sync once when the container starts, as well as on the schedule. Off by default:
# the stack gets restarted repeatedly while being set up, and each restart would be
# another pass over someone else's server for no new data. Useful after downtime, when
# you would otherwise wait until the next SYNC_AT to catch up.
# SYNC_ON_START=false

# Gunicorn sizing. Drop the workers to 2 if the Docker VM is memory-constrained.
# GUNICORN_WORKERS=3
# GUNICORN_THREADS=2


# ---------------------------------------------------------------------------
# Announcing to Discord channels (optional) — arrivals, and deployments
# ---------------------------------------------------------------------------

# ARRIVALS: a Discord incoming webhook. Blank, which is the default, means nothing is
# announced there. With one set, the instance posts whenever a new script arrives or a
# script already held gains a newer version — from the upload form, the API, an import,
# the daily sync, the admin or the shell.
#
# Get one from Discord: the channel -> Edit Channel -> Integrations -> Webhooks ->
# New Webhook -> Copy Webhook URL. Who sees the announcements is then a property of that
# channel, so moving the audience is a Discord change and needs nothing here.
#
# This URL is a secret: anyone holding it can post to that channel.
#
# Check it without waiting for a real upload:
#   docker compose exec botc-scripts python manage.py test_notification --arrivals
# With no flag, test_notification checks every webhook that is configured.
# DISCORD_ARRIVALS_WEBHOOK_URL=

# Prepended to each announcement. Must be ids, not names — "@lewis" is sent as plain
# text and pings nobody. The forms that work:
#   <@&ROLE_ID>   a role          <@USER_ID>   a person          @here / @everyone
# Note the @, and the & for a role: a bare <ID> is also just text. Several at once are
# space-separated, no quotes needed. Get ids with Discord -> Settings -> Advanced ->
# Developer Mode on, then right-click the role or person -> Copy Role ID / Copy User ID.
# Only ids named here may ping — a script called "@everyone" cannot ping the channel.
# DISCORD_ARRIVALS_WEBHOOK_MENTION=

# A SECOND, separate webhook, for when a version is marked as on the Minecraft server —
# so deployments can go to a different channel from arrivals. Make it on whichever
# channel should see deployments. Each message says what went on, what it replaced (or
# that it was a rollback), and who marked it. Independent of arrivals above: set either,
# both, or neither. Check it with:
#   docker compose exec botc-scripts python manage.py test_notification --online
# DISCORD_ONLINE_WEBHOOK_URL=

# Same format as DISCORD_ARRIVALS_WEBHOOK_MENTION, for deployment announcements only.
# DISCORD_ONLINE_WEBHOOK_MENTION=

# The site's public address, e.g. https://scripts.example.com. Two things use it:
#
#  * Announcements, for the links in them. Nothing outside a web request knows the site's
#    own address and the sync container never has one, so it is configured here. Left
#    blank, the first CSRF_TRUSTED_ORIGINS entry is used; with neither, announcements still
#    send but carry no link.
#  * The Discord bot, for the script links in its replies (as BOTC_PUBLIC_URL). The bot
#    reaches the app at http://botc-scripts:8000, which only resolves inside this stack, so
#    without this its links are unusable. It does NOT fall back to CSRF_TRUSTED_ORIGINS,
#    so set this even if that is already right.
# SITE_URL=


# ---------------------------------------------------------------------------
# Accounts created on first boot by `manage.py bootstrap` (idempotent)
# ---------------------------------------------------------------------------

# The Django admin superuser, for /admin. If DJANGO_SUPERUSER_PASSWORD is left blank
# NO superuser is created — bootstrap prints a warning instead of inventing a password.
# You can always create one by hand:
#   docker compose run --rm botc-scripts python manage.py createsuperuser
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# The account the Discord bot authenticates as (HTTP Basic) when it writes slugs.
# It is granted scripts.api_write_permission and nothing else — not staff, not superuser.
# Leave the password blank to skip creating it; slug writes will then be refused with 403.
# BOTC_API_USERNAME=discordbot
# BOTC_API_EMAIL=
BOTC_API_PASSWORD=

# Passwords are only ever set when an account is first created. Set this to True for one
# boot to force-reset both to the values above, then set it back.
# BOOTSTRAP_RESET_PASSWORDS=False


# ---------------------------------------------------------------------------
# The Discord bot
# ---------------------------------------------------------------------------

# From https://discord.com/developers/applications -> Bot -> Reset Token.
# Leave blank and the bot exits cleanly with code 2; the database and app come up fine
# and `docker compose run --rm bot python tools/live_check.py` still works.
DISCORD_TOKEN=

# Optional. A guild (server) id registers slash commands there instantly instead of
# waiting up to an hour for a global sync. Useful while setting things up.
# DISCORD_GUILD_ID=

# Optional tuning. BOTC_BASE_URL and BOTC_CACHE_PATH are NOT listed here: the compose
# file pins them to http://botc-scripts:8000 and the bot's named volume.
# BOTC_CACHE_ENTRIES=500   # 0-100000. 0 disables the autocomplete cache entirely.
# BOTC_RENDER_DPI=150      # 50-400. Higher is sharper and much larger.
# BOTC_MAX_PAGES=10        # 1-10. Pages rendered per script; the rest are linked.
# BOTC_HTTP_TIMEOUT=60     # Seconds, total, per request to the app.
# LOG_LEVEL=INFO           # CRITICAL, ERROR, WARNING, INFO or DEBUG.
# BOTC_SELECTION=auto      # auto, online or latest. auto is online here. Not /alias.
